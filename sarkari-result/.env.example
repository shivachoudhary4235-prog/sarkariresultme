# ===========================================================
#  SARKARI RESULT — MONOREPO ROOT ENVIRONMENT VARIABLES
#  Copy this to .env and fill in your values.
#  Never commit .env to version control.
# ===========================================================

# ── Supabase (PUBLIC — safe for browser, bound to RLS) ─────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# ── Supabase (SERVER-ONLY — NEVER expose to browser) ────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── Database direct connection (for migrations/scripts) ─────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Gemini AI (SERVER-ONLY) ──────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── App URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── API internal secret (for server-to-server auth) ─────────
API_SECRET=your_strong_random_secret_minimum_32_chars

# ── JWT / Session ─────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_minimum_32_chars
SESSION_EXPIRY_HOURS=8

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ── Storage ──────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=sarkari-media
MAX_FILE_SIZE_MB=10

# ── Node API server ───────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── Admin ─────────────────────────────────────────────────────
ADMIN_PORT=3001

# ── Public web ────────────────────────────────────────────────
WEB_PORT=3000
