{
  "name": "sarkari-result-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules",
    "db:migrate": "pnpm --filter @sarkari/api db:migrate",
    "db:seed": "pnpm --filter @sarkari/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ]
}
